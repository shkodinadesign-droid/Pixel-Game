// ===== ЛЕС: ЛЯГУШОНОК У БОЛЬШОГО КАМНЯ (STEP) =====
near_player = false;
if (!instance_exists(obj_max)) exit;

var p = instance_find(obj_max, 0);
var _fx = (p.bbox_left + p.bbox_right) * 0.5;
var _fy = p.bbox_bottom;
near_player = point_distance(x + 16, y + 24, _fx, _fy) < 56;

if (!near_player || global.control_locked) exit;
if (!keyboard_check_pressed(ord("E"))) exit;

forest_mark_progress("forest_glade_found");

if (!global.frog_talk_done) {
    // Первая встреча. Макс впервые видит лягушонка (ночью она спала) — и он разговаривает.
    // Первый намёк на прошлое Сони (подробно не раскрываем). Тайна леса: тропа идёт только по краю,
    // глубже — места и существа, которых в деревне не замечают. Один необычный ингредиент для интереса
    // (лунная ягода — пример, ещё не предмет). Дальше в лес — только с Мечом героя; лягушонок не знает, где он,
    // но помнит знак прежнего владельца — он загорается на камне, а такой же есть на тайной двери в пекарне.
    // Строки страниц не длиннее ~44 символов: obj_ui_dialog_seq не переносит их сам.
    var _d = dialog_seq_start([
        forest_page("max",  ["Это ты оставил карту?"]),
        forest_page("frog", ["А ты приготовила пуддинг?"]),
        forest_page("max",  ["Подожди. Ты разговариваешь?"]),
        forest_page("frog", ["Только когда меня не перебивают."]),
        forest_page("frog", ["..."]),
        forest_page("frog", ["Хороший пуддинг. Давно такого не было."]),
        forest_page("max",  ["Это рецепт моей бабушки."]),
        forest_page("frog", ["Сони?"]),
        forest_page("max",  ["Ты её знаешь?"]),
        forest_page("frog", ["Она тоже однажды пришла сюда", "с кучей вопросов."]),
        forest_page("frog", ["Обычная тропа идёт только по краю леса.", "Дальше есть места и жители,", "которых в деревне почти не замечают."]),
        forest_page("frog", ["Ты думаешь, всё для твоей пекарни", "растёт на грядках?", "Здесь тоже есть что собирать."]),
        forest_page("frog", ["Только сначала нужно понять, что можно", "положить в корзину, а что само", "утащит твою корзину."]),
        forest_page("max",  ["Например?"]),
        forest_page("frog", ["Лунная ягода. Созревает в сумерках", "и слабо светится."]),
        forest_page("max",  ["Светится?.. Интересно, какое из неё", "получится варенье."]),
        forest_page("max",  ["Тогда покажи, где всё это растёт."]),
        forest_page("frog", ["У края леса - покажу.", "А дальше тебе пока рано."]),
        forest_page("max",  ["Почему?"]),
        forest_page("frog", ["Потому что я могу спрятаться под корнем.", "Ты - вряд ли."]),
        forest_page("frog", ["Глубже живут разные существа.", "Одни помогают путникам, другие обманывают,", "третьи нападают или стерегут свою землю."]),
        forest_page("frog", ["Туда без защиты не ходят."]),
        forest_page("max",  ["И где мне взять меч?", "У Джо между мукой и сахаром?"]),
        forest_page("frog", ["Обычный здесь мало поможет.", "Тебе нужен Меч героя."]),
        forest_page("max",  ["Звучит как вещь, которую", "просто так не отдают."]),
        forest_page("frog", ["Обычно сначала хотя бы находят."]),
        forest_page("frog", ["Где он сейчас - не знаю.", "Но помню знак его прежнего хозяина."]),
        forest_page("frog", ["Ищи такую отметку.", "Соня знала, что она означает."]),   // SIGN_PAGE: знак на камне загорается
        forest_page("max",  ["Бабушка? Но она никогда..."]),
        forest_page("frog", ["Взрослые многое не договаривают.", "Особенно когда пишут про полив моркови."]),
        forest_page("frog", ["И одного меча мало. Надо научиться", "защищаться и готовиться к походам.", "Но это потом."]),
        forest_page("max",  ["Ладно. Сначала найду эту отметку."])
    ], "frog_talk");
    with (_d) {                                           // страница, с которой на камне светится знак
        for (var _i = 0; _i < array_length(pages); _i++) if (pages[_i].lines[0] == "Ищи такую отметку.") sign_page = _i;
    }
} else {
    // Повторная встреча — короткая реплика, первая сцена не повторяется
    dialog_seq_start([
        global.door_sign_found
            ? forest_page("frog", ["Нашла отметку? Хорошо.", "Теперь узнай, что за ней прячется."])
            : forest_page("frog", ["Отметку нашла? Нет? Тогда что стоишь?", "А край леса - твой, гуляй."])
    ], "");
}
