// ===== ДЖАСТИН ПРИХОДИТ НА ФЕРМУ (CREATE) — день 3+, один раз =====
// Спокойный личный разговор: поблагодарить за картофельный пирог и познакомиться поближе.
// Создаёт obj_day_controller (Step), когда Макс свободна на ферме с 10:00 до 17:00 и пирог отдан в прошлые дни.
// Без денег, предметов и новых поручений. Часы на время разговора стоят (global.clock_paused).
// Контекст на будущее: Макс 14,5 — школьница из города, хочет потом учиться на кондитера;
// Джастину 16 — живёт с дедом, только закончил старшую школу и пока не знает, чем хочет заниматься.
// Спрайты spr_justin_* 32x56, начало — левый верх.

entry_x = 1290; entry_y = 392;          // вход на ферму справа (obj_village_entrance 1248,368)
x = entry_x; y = entry_y;
spd   = 2;
face  = "left";                          // left / right / up / down
moving = false;
look  = "";                              // куда смотрит во время паузы ("left" — на огород)

// Встаёт рядом с Макс: справа от неё (если у края комнаты — слева), ступни на одной линии
var _mx = instance_exists(obj_max) ? obj_max.x : 640;
var _my = instance_exists(obj_max) ? obj_max.y : 400;
side = (_mx + 44 < room_width - 48) ? 1 : -1;
target_x = _mx + 44 * side;
target_y = _my - 8;                      // Макс 32x48, Джастин 32x56
path_in  = [[target_x, entry_y], [target_x, target_y]];   // сначала по горизонтали, потом к Макс
path_out = [[target_x, entry_y], [entry_x, entry_y]];
wp = 0;

state  = "enter";                        // enter -> talk -> leave
dlg_i  = 0;
pause_t = 0;
_click_prev = true;

// Пирог забрал вчера — «вчера»; если визит перенёсся на несколько дней — «тогда»
var _today = instance_exists(obj_day_controller) ? obj_day_controller.day_index : 3;
var _when  = (_today - global.justin_pie_day <= 1) ? "вчера" : "тогда";

// Реплики. ["~", кадры, взгляд] — пауза без окна диалога (взгляд: "left" — оглядывает огород, "" — на Макс)
lines = [
    ["Джастин:", "Привет! Не отвлекаю?"],
    ["Макс:",    "Привет. Что-то случилось с пирогом?"],
    ["Джастин:", "Да. Он закончился."],
    ["Макс:",    "Уже?"],
    ["Джастин:", "Мы с дедом собирались оставить кусочек на утро. Не получилось."],
    ["Макс:",    "Значит, нормально вышел."],
    ["Джастин:", "Очень вкусно. Я " + _when + " как-то быстро убежал. Хотел нормально сказать спасибо."],
    ["Макс:",    "Пожалуйста. Я вообще-то переживала, когда его готовила."],
    ["Джастин:", "Незаметно было."],
    ["~", 70, "left"],
    ["Джастин:", "Ты тут теперь со всем сама разбираешься?"],
    ["Макс:",    "Пытаюсь. Мэгги помогает. И бабушка пишет, что делать."],
    ["Макс:",    "Правда, в письмах всё звучит проще."],
    ["Джастин:", "Дед тоже любит говорить: \"Да там на пять минут\"."],
    ["Макс:",    "А потом проходит полдня?"],
    ["Джастин:", "И ты всё ещё ищешь нужную лопату."],

    ["Джастин:", "А в городе ты как жила? Чем занималась?"],
    ["Макс:",    "В школу ходила. Уроки, домой, иногда с подругами гуляли."],
    ["Макс:",    "Когда было время, пробовала что-нибудь печь."],
    ["Джастин:", "Тоже по бабушкиным рецептам?"],
    ["Макс:",    "Иногда. Иногда находила другие."],
    ["Макс:",    "Один раз печенье получилось таким твёрдым, что мы его размачивали в чае."],
    ["Джастин:", "Зато не раскрошилось."],
    ["Макс:",    "Вообще ни разу."],
    ["~", 50, ""],
    ["Макс:",    "Я хочу потом пойти учиться на кондитера."],
    ["Джастин:", "Серьёзно?"],
    ["Макс:",    "Ага. Мне нравится, когда из обычных продуктов получается что-то вкусное."],
    ["Макс:",    "И когда кто-нибудь пробует и просит ещё."],
    ["Джастин:", "Тогда наш пирог считается хорошим отзывом."],
    ["Макс:",    "Считается. Поэтому я и подумала: пока бабушка лечится, помогу ей здесь."],
    ["Макс:",    "Заодно пойму, как всё работает по-настоящему."],
    ["Макс:",    "Дома испечь что-нибудь - одно. А когда человек заказал и ждёт..."],
    ["Джастин:", "Уже страшнее?"],
    ["Макс:",    "Немного. Но хочется научиться."],

    ["Макс:",    "А ты? Чем хочешь заниматься?"],
    ["Джастин:", "Вот это сложный вопрос."],
    ["Макс:",    "Почему?"],
    ["Джастин:", "Школу только закончил. Все спрашивают, что дальше. А я пока не знаю."],
    ["Макс:",    "Совсем никаких идей?"],
    ["Джастин:", "Идеи бывают. Потом думаю: а вдруг мне вообще не понравится?"],
    ["Джастин:", "Пока живу с дедом, помогаю ему по хозяйству."],
    ["Джастин:", "Он говорит, можно попробовать поработать с ним."],
    ["Макс:",    "А тебе хочется?"],
    ["Джастин:", "Не знаю. Ему нравится. А я пока просто умею делать то, что он показывает."],
    ["~", 60, ""],
    ["Макс:",    "Я тоже не знаю, получится ли у меня с кондитерским делом."],
    ["Макс:",    "Пока только хочу попробовать."],
    ["Джастин:", "Но ты хотя бы знаешь, что пробовать."],
    ["Макс:",    "Ну... пирог ты оценил. Если что, будешь пробовать мои неудачные рецепты."],
    ["Джастин:", "Подожди. Почему именно неудачные?"],
    ["Макс:",    "Удачные я буду продавать."],
    ["Джастин:", "Отлично устроилась."],

    ["Джастин:", "Ладно, пойду. Дед просил вернуться пораньше."],
    ["Макс:",    "Спасибо, что зашёл."],
    ["Джастин:", "Можно ещё как-нибудь? Без заказа."],
    ["Макс:",    "Конечно. Только если я буду вся в муке - не пугайся."],
    ["Джастин:", "После того пирога меня это не остановит."],
    ["Джастин:", "Ладно, Макс, приятно было поболтать. Я пошёл!"],
    ["Макс:",    "Пока!"],
];

// Окно диалога — как у Тоби: 620 шириной, сверху экрана, кнопка справа внизу
dlg_w = 620; dlg_h = 50 + 3 * 24 + 50; dlg_y = 20; dlg_pad = 14; btn_w = 120; btn_h = 30;
