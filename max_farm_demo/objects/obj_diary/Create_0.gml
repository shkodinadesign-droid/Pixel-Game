// ===== DIARY CREATE =====

// Блокируем управление
global.control_locked = true;

audio_play_sound(snd_book_open, 1, false, 0.6);

// Текущая вкладка (0-6)
current_tab = 0;

// Масштаб дневника: подложка spr_diary_bg рисуется 1:1 (824x473), bs — множитель для отступов и размеров элементов
book_scale = 1.5;

// Размеры книги (GUI координаты) — по размеру спрайта подложки
var gui_w = display_get_gui_width();
var gui_h = display_get_gui_height();

book_w = sprite_get_width(spr_diary_bg);   // 824
book_h = sprite_get_height(spr_diary_bg);  // 473
book_x = round((gui_w - book_w) / 2);
book_y = round((gui_h - book_h) / 2);

// Разметка подложки (пиксели спрайта spr_diary_bg, замерены по арту) — общая для Draw_64 и Step
ui_tabs  = [[48,0,102,48], [106,0,156,48], [165,0,215,48], [224,0,274,48], [282,0,332,48], [341,0,391,48], [400,0,449,48]];
ui_close = [800, 32, 15];          // кнопка-крестик: центр x, y и радиус
ui_title = [225, 106];             // центр таблички с названием раздела (левая страница)
ui_left  = [64, 146, 384, 390];    // область содержимого левой страницы (под табличкой)
ui_sheet = [453, 101, 751, 285];   // белый лист на правой странице (сверху по центру — закладка до y 125)
ui_low   = [440, 308, 764, 390];   // свободное место под белым листом
ui_list  = [72, 150, 304];         // списки (задания, дружба): x, y первой строки и ширина
ui_inv   = [94, 164, 48, 5];       // сетка инвентаря 5x4: x, y, размер ячейки, промежуток
ui_rcat  = [72, 146, 376, 172];    // кнопки категорий рецептов
ui_rgrid = [120, 182, 46, 8];      // сетка рецептов 4x4: x, y, размер ячейки, промежуток

// Названия вкладок
tab_names = ["Задания", "Инвентарь", "Рецепты", "Растения", "Приключения", "Дружба", "Деньги"];

// Выбранный предмет в инвентаре (-1 = ничего)
selected_item = -1;

// Выбранное задание во вкладке "Задания" ("" = ничего)
selected_quest = "";

// Вкладка "Рецепты": текущая категория и выбранный рецепт ("" = ничего)
recipe_category = "baking";
selected_recipe = "";

// Выбранный персонаж во вкладке "Дружба" ("" = ничего)
selected_friend = "";

// Отслеживание кликов
// true = пропускаем клик открытия, иначе дневник закроется в первом же кадре
_click_prev = true;

// Игрок открыл дневник — останавливаем прыжок (! остаётся, но не прыгает)
if (!variable_global_exists("diary_was_read")) global.diary_was_read = false;
global.diary_was_read = true;
