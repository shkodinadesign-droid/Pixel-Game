// ===== МАКС В ПЕЩЕРЕ — ВИД СБОКУ (CREATE) =====
// Создаётся контроллером комнаты (obj_cave_controller / obj_clay_arena). x,y — левый верх коробки SIDE_BW x SIDE_BH.
// Управление: стрелки / A D — идти, Пробел / стрелка вверх / W — прыжок (дольше держишь — выше прыжок).
hsp = 0; vsp = 0;
GRAV   = 0.5;
JUMP_V = -9.6;     // высота прыжка ~90 px
MOVE   = 3;
on_ground = false;
coyote = 0;        // можно прыгнуть ещё несколько кадров после схода с края
jbuf   = 0;        // нажатие прыжка чуть раньше приземления не теряется
facing = 1;        // 1 — вправо, -1 — влево
anim_t = 0;
frozen = false;    // контроллер замораживает (сцена, сброс фазы)
hurt_t = 0;        // мигание после попадания
jumps  = 0;        // сколько раз прыгнула — для подсказки управления
depth  = -100;
if (instance_exists(obj_camera)) obj_camera.follow_obj = id;
