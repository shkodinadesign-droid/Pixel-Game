// ===== МЭГГИ ДОМА: СИДИТ НА СТУЛЕ ЗА СТОЛОМ И ПЬЁТ ЧАЙ (CREATE) =====
// Экземпляр — это стол (spr_coffee_table 65x41, x,y — левый верх; маска — низ стола, Макс в него упирается).
// Стул, Мэгги, второй стул, чашка и пар рисуются в Draw. Сидячего спрайта у Мэгги нет: рисуем верх
// spr_maggie_idle_right (голова и туловище) на стуле, а передний край сиденья и стол — поверх неё.
// Временная сборка из имеющихся спрайтов — потом дорисуем.
// Разговор: после лягушонка Макс приходит спросить про тайный знак — Мэгги заговаривает сама, как только
// Макс вошла: пуддинг и лягушонок -> знак, как на двери пекарни -> особенные рецепты Сони -> ключ в старом
// тайнике -> фотография -> «Посмотри, что лежит у корней» (maggie_sign_talk_done). Дальше — тайник у яблони.
forest_episode_init();
depth = -bbox_bottom;

chair_x = x - 14;  chair_y = y - 14;     // стул Мэгги (spr_cafe_chair_Left — спинка слева, сидят лицом вправо)
mg_x    = x - 12;  mg_y    = y - 36;     // левый верх Мэгги
MG_CUT  = 44;                            // сколько строк Мэгги видно над сиденьем
SEAT    = 24;                            // строка стула, с которой его рисуем поверх Мэгги
chair2_x = x + 50; chair2_y = y - 14;    // свободный стул напротив (для Макс)
cup_x   = x + 12;  cup_y   = y - 3;      // чашка на столе
cup_xs  = 16 / sprite_get_width(spr_dish_tea_grandma);
cup_ys  = 14 / sprite_get_height(spr_dish_tea_grandma);

near_player = false;
greet_wait  = 40;                        // пауза после входа, прежде чем Мэгги заговорит
