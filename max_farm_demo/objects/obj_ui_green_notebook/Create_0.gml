// ===== ЗЕЛЁНАЯ ТЕТРАДЬ СОНИ (CREATE) =====
// Первое открытие в тайной комнате: среди рецептов — рисунок Меча героя и незаконченная запись о месте.
// Место меча, способ получения и испытание сознательно НЕ раскрыты (решим вместе с продолжением):
// запись обрывается кляксой. Текст страниц — черновик Claude, его можно переписать.
// Временная графика кодом; если появится спрайт spr_green_notebook_spread — будет показан он под текстом.
then_event  = "";
open_delay  = 10;
owns_lock   = !global.control_locked;
global.control_locked = true;
_click_prev = true;
book_spr    = asset_get_index("spr_green_notebook_spread");

bw = 620; bh = 360;
bx = (display_get_gui_width() - bw) / 2;
by = (display_get_gui_height() - bh) / 2 - 16;
btn_w = 140; btn_h = 30;
btn_x1 = bx + bw - btn_w - 20; btn_y1 = by + bh + 12;

left_lines = [
    "Пирог с лунной ягодой:",
    "сахара меньше - ягода",
    "и так сладкая.",
    "Печь только в сумерках (?)"
];
right_lines = [
    "Меч героя.",
    "Видела его своими глазами.",
    "Рукоять тёплая, будто его",
    "только что держали.",
    "",
    "Он лежит там, где"
];
