// ===== ЗЕЛЁНАЯ ТЕТРАДЬ СОНИ (CREATE) =====
// Три разворота, листаются кнопками / стрелками:
//  1) рисунок автора spr_green_notebook_sword: Меч героя | запись о Джо (текст нарисован на картинке)
//  2) дорогу спросить у Джо | набросок скал и приписка «Джо помнит поворот у расколотого камня»
//  3) рецепт пирога с лунной ягодой | пустая страница
// Запись направляет к Джо: не говорит, получила ли Соня меч, и не раскрывает испытаний.
// Временная графика кодом; если появится спрайт spr_green_notebook_spread — будет показан он под текстом.
then_event  = "";
open_delay  = 10;
owns_lock   = !global.control_locked;
global.control_locked = true;
_click_prev = true;
book_spr    = asset_get_index("spr_green_notebook_spread");
sword_spr   = asset_get_index("spr_green_notebook_sword");   // разворот 1 целиком картинкой (820x502)

spread  = 0;
SPREADS = 3;

bw = 620; bh = 360;
bx = (display_get_gui_width() - bw) / 2;
by = (display_get_gui_height() - bh) / 2 - 16;
btn_w = 140; btn_h = 30;
btn_y1 = by + bh + 12;
btn_x1 = bx + bw - btn_w - 20;   // «Дальше» / «Закрыть»
back_x1 = bx + 20;               // «Назад»

page_w  = bw / 2 - 36;           // ширина строки текста на странице
line_h  = 21;

// текст записи (без «» и длинных тире — их нет в шрифте)
txt_jack_1 = "Джо всегда сопровождал меня в приключениях. Мы были такими друзьями, что мне казалось: вдвоём можно добраться куда угодно.";
txt_jack_2 = "Я придумывала, куда пойти, а он брал верёвку, фонарь и что-нибудь поесть. Обычно именно его приготовления нас и выручали.";
txt_jack_3 = "Однажды мы отправились искать Меч героя. Джо узнал о пещере, спрятанной среди скал, и нашёл к ней дорогу. У входа я чуть не передумала - из темноты доносились такие звуки, будто гора ворочалась во сне.";
txt_jack_4 = "Джо сказал, что подождёт меня снаружи.";
txt_jack_5 = "Дорогу к той пещере лучше спросить у Джо: я опять нарисовала карту так, что сама ничего не понимаю.";
txt_note   = "Джо помнит поворот у расколотого камня";
txt_recipe = "Пирог с лунной ягодой:\n\nсахара меньше - ягода и так сладкая.\nПечь только в сумерках (?)";
